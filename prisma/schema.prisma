model DeploymentTarget {
  id               String    @id @default(uuid())
  workspaceId      String    @default("00000000-0000-0000-0000-000000000001") @map("workspace_id")
  name             String
  targetType       String    @map("target_type") // LOCAL_HOST, LOCAL_DOCKER, REMOTE_HOST, REMOTE_DOCKER
  connectionMode   String    @map("connection_mode") // LOCAL, SSH, TAILSCALE, DIRECT_WS, REVERSE_PROXY
  host             String?
  port             Int?
  sshUser          String?   @map("ssh_user")
  sshPort          Int?      @map("ssh_port")
  gatewayUrl       String?   @map("gateway_url")
  dockerEnabled    Boolean   @default(false) @map("docker_enabled")
  tailscaleEnabled Boolean   @default(false) @map("tailscale_enabled")
  envType          String    @default("DEV") @map("env_type") // DEV, STAGING, PROD
  status           String    @default("UNKNOWN") // UNKNOWN, HEALTHY, DEGRADED, UNREACHABLE
  lastCheckAt      DateTime? @map("last_check_at")
  metadata         String    @default("{}") // JSON: additional config
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  workspace         Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
