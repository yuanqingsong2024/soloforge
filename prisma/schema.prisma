  agentRegistrations AgentRegistration[]
  agentActions      AgentAction[]
  jobs              DeploymentJob[]
  installedVersions InstalledVersion[]
  upgradePlans      UpgradePlan[]
  upgradeRuns       UpgradeRun[]

  @@index([workspaceId])
  @@index([status])
  @@index([envType])
  @@map("deployment_targets")
}

model HostAgent {
  id              String   @id @default(uuid())
  workspaceId     String   @map("workspace_id")
  targetId        String?  @map("target_id")
  name            String
  hostname        String
  osType          String   @map("os_type")
  arch            String
  agentVersion    String   @map("agent_version")
  status          String   @default("UNREGISTERED") // ONLINE, OFFLINE, DEGRADED, UNKNOWN, UNREGISTERED
