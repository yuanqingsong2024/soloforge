  authMode        String   @default("TOKEN") @map("auth_mode") // TOKEN, MTLS, BOOTSTRAP_SECRET
  capabilitiesJson String  @default("{}") @map("capabilities_json")
  labelsJson      String   @default("{}") @map("labels_json")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  workspace  Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  target     DeploymentTarget? @relation(fields: [targetId], references: [id], onDelete: SetNull)
  actions    AgentAction[]
  heartbeats AgentHeartbeat[]
  logs       AgentLog[]

  @@index([workspaceId])
  @@index([targetId])
  @@index([status])
  @@index([lastHeartbeatAt])
  @@map("host_agents")
}

model AgentRegistration {
