model HermesWorker {
  id           String   @id @default(uuid())
  name         String   @unique // Worker 名称，如 "hermes-dev", "hermes-analysis"
  description  String   @default("")
  baseUrl      String   @map("base_url") // Hermes API 地址
  wsUrl        String?  @map("ws_url") // WebSocket 地址（可选）
  authTokenRef String?  @map("auth_token_ref") // Keychain 中存储的 token 引用
  enabled      Boolean  @default(true)
  tags         String   @default("[]") // JSON: ["code", "analysis", "general"]
  capabilities String   @default("{}") // JSON: 支持的能力列表
  lastHealthAt DateTime? @map("last_health_at")
  lastHealthStatus String? @map("last_health_status") // OK, ERROR, UNKNOWN
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  tasks HermesTask[]

  @@index([enabled])
  @@map("hermes_workers")
}

model HermesTask {
  id        String   @id @default(uuid())
  workerId  String   @map("worker_id")
  ticketId  String?  @map("ticket_id") // 可选关联工单
  taskType  String   @map("task_type") // "code", "analysis", "general", "custom"
  prompt    String   // 任务描述
  context   String   @default("{}") // JSON: 上下文数据
  status    String   // PENDING, RUNNING, SUCCEEDED, FAILED, CANCELED
  result    String?  // JSON: 执行结果
  error     String?  // 错误信息
  logs      String?  // 执行日志
  traceId   String   @map("trace_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  worker HermesWorker @relation(fields: [workerId], references: [id], onDelete: Cascade)
  ticket Ticket?      @relation(fields: [ticketId], references: [id], onDelete: SetNull)

  @@index([workerId])
  @@index([ticketId])
  @@index([status])
  @@index([traceId])
  @@map("hermes_tasks")
}

