{
  "name": "soloforge",
  "version": "0.1.0",
  "description": "SoloForge - AI Team OS Desktop Application",
  "author": "SoloForge Team",
  "license": "MIT",
  "homepage": "https://soloforge.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/soloforge/soloforge"
  },
  "keywords": [
    "ai",
    "agent",
    "automation",
    "desktop",
    "electron",
    "team-management",
    "workflow",
    "claude-code"
  ],
  "main": "dist-electron/main/index.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:oneclick": "node scripts/one-click-dev.mjs",
    "dev:oneclick:ps1": "powershell -ExecutionPolicy Bypass -File scripts/one-click-dev.ps1",
    "prebuild": "node scripts/prebuild.mjs",
    "build": "npm run prebuild && tsc && vite build && electron-builder --publish never",
    "release:check": "node scripts/release-check.mjs",
    "release:generate-checksums": "node scripts/generate-release-checksums.mjs",
    "release:verify-checksums": "node scripts/verify-release-checksums.mjs",
    "release:verify-runtime": "node scripts/verify-packaged-runtime.mjs",
    "preview": "vite preview",
    "postinstall": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "dev:hermes-mock": "tsx src/scripts/hermes-mock-server.ts",
    "test:unit": "node --test --import tsx tests/unit/**/*.test.ts",
    "test": "npm run test:unit && npm run test:renderer && npm run test:integration",
    "test:coverage": "vitest run --config vitest.config.ts --coverage",
    "test:renderer": "vitest run --config vitest.config.ts",
    "test:renderer:watch": "vitest --config vitest.config.ts",
    "test:integration": "node scripts/run-integration-tests.mjs",
    "test:integration:watch": "vitest --config vitest.integration.config.ts",
    "test:e2e": "playwright test tests/e2e",
    "test:e2e:headed": "playwright test tests/e2e --headed",
    "test:e2e:debug": "playwright test tests/e2e --debug",
    "test:e2e:live-openclaw": "playwright test tests/e2e/outbound-live-openclaw.spec.ts",
    "test:e2e:live-openclaw:headed": "playwright test tests/e2e/outbound-live-openclaw.spec.ts --headed",
    "test:e2e:live-openclaw:debug": "playwright test tests/e2e/outbound-live-openclaw.spec.ts --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report test-results/html",
    "release:validate": "node scripts/validate-release.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fastify/cors": "^11.3.0",
    "@prisma/client": "^5.8.1",
    "@types/dockerode": "^4.0.1",
    "@types/js-yaml": "^4.0.9",
    "@types/ssh2": "^1.15.5",
    "dockerode": "^5.0.1",
    "fastify": "^5.12.1",
    "i18next": "^26.0.8",
    "i18next-http-backend": "^3.0.6",
    "js-yaml": "^4.3.1",
    "jsondiffpatch": "^0.7.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.6",
    "react-router-dom": "^7.18.2",
    "ssh2": "^1.17.0",
    "uuid": "^11.1.1",
    "ws": "^8.21.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.11.5",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@vitejs/plugin-react": "^4.2.1",
    "@vitest/coverage-v8": "^4.1.11",
    "autoprefixer": "^10.4.17",
    "electron": "^30.5.1",
    "electron-builder": "^24.9.1",
    "jsdom": "^30.0.1",
    "playwright": "^1.58.2",
    "postcss": "^8.4.33",
    "prisma": "^5.8.1",
    "sharp": "^0.35.3",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vite": "^5.0.11",
    "vite-plugin-electron": "^0.28.2",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.soloforge.app",
    "productName": "SoloForge",
    "icon": "build/icon.png",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "node_modules/**/*.node",
      "node_modules/@prisma/client/**/*",
      "node_modules/.prisma/client/**/*"
    ],
    "directories": {
      "output": "release/${version}"
    },
    "files": [
      "dist",
      "dist-electron"
    ],
    "extraResources": [
      "resources/locales/**/*",
      {
        "from": "node_modules/.prisma",
        "to": "app/node_modules/.prisma",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "linux": {
      "category": "Utility",
      "target": [
        "AppImage"
      ]
    }
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.4",
    "@protobufjs/utf8": "^1.1.1",
    "protobufjs": "^7.6.5",
    "fast-uri": "^3.1.5",
    "find-my-way": "^9.7.0"
  }
}
